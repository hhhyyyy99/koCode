{
  "name": "kocode-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx packages/ko-cli/src/index.ts",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run --config vitest.config.ts",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@kocode/ko-ai": "workspace:*",
    "@kocode/ko-agent": "workspace:*",
    "@kocode/ko-tui": "workspace:*",
    "@kocode/ko-cli": "workspace:*",
    "@types/node": "^22.15.29",
    "@types/react": "^18.2.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.1.4"
  }
}
